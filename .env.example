# Ollama must be reachable from the Node.js process.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Microsoft Learn remote MCP server
MCP_ENABLED=true
MCP_URL=https://learn.microsoft.com/api/mcp

# Local HTTP API
HOST=127.0.0.1
PORT=3000

# Browser origin allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Agent safety limit
MAX_TOOL_ITERATIONS=8
REQUEST_TIMEOUT_MS=120000
